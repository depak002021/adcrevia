# Adcrevia production configuration for the Docker Compose deployment.
#
# Copy to `.env.production` in the repository root on the server and fill in every
# value marked REQUIRED. That file is read by all four compose services and is never
# committed (.gitignore) or sent into an image (.dockerignore). Keep it chmod 600.
#
# Generate the two secrets on the server with:
#   openssl rand -hex 32        -> AUTH_SECRET
#   openssl rand -base64 32     -> ENCRYPTION_KEY
# ENCRYPTION_KEY encrypts provider credentials stored in the database. Changing it later
# makes every stored provider key unreadable, so generate it once and back it up.

# --- Public URLs (REQUIRED) -------------------------------------------------------------
# The exact origin people use. The cross-origin guard in src/proxy.ts allows only this
# origin for form posts, so it must match what is in the browser's address bar
# (https, no trailing slash, and the same www/non-www choice nginx redirects to).
APP_URL="https://adcrevia.com"
NEXTAUTH_URL="https://adcrevia.com"
# Canonical URL for the landing page's metadata. Read at BUILD time by deploy.sh.
NEXT_PUBLIC_SITE_URL="https://adcrevia.com"

# --- Database (REQUIRED) ----------------------------------------------------------------
# Read by the postgres container on first start to create the database and role.
POSTGRES_DB="adcrevia"
POSTGRES_USER="adcrevia"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
# Must repeat the three values above. `db` is the compose service name; no sslmode is
# needed because the connection never leaves the private compose network.
DATABASE_URL="postgresql://adcrevia:replace-with-a-long-random-password@db:5432/adcrevia"

# --- Secrets (REQUIRED) -----------------------------------------------------------------
AUTH_SECRET="replace-with-openssl-rand-hex-32"
ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# --- First administrator (used once by `deploy.sh bootstrap-admin`) ---------------------
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="replace-with-a-unique-password-of-16-or-more-characters"
SUPER_ADMIN_NAME="Adcrevia Administrator"

# --- AI providers -----------------------------------------------------------------------
# /api/health reports "degraded" (HTTP 503) until OpenAI, R2, Runway and Resend are all
# set. The site and the waitlist still work; only generation features need them.
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-5-mini"
OPENAI_IMAGE_MODEL="gpt-image-1.5"
OPENAI_AGENT_MODEL=""
OPENAI_DECISION_MODEL=""
DECISION_PROVIDER=""
TYPESAFE_API_KEY=""
TYPESAFE_DECISION_MODEL=""
TYPESAFE_DECISION_ENDPOINT=""
RUNWAYML_API_SECRET=""
RUNWAY_VIDEO_MODEL="gen4.5"
BFL_API_KEY=""
BFL_IMAGE_MODEL="flux-2-pro"
BFL_VIDEO_MODEL="flux-3-video"

# --- Media storage ----------------------------------------------------------------------
# Cloudflare R2 or any S3-compatible bucket. Without it, media is written to the `media`
# Docker volume and served from the app's own origin.
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# --- Email ------------------------------------------------------------------------------
# One transport is required: SMTP (used when SMTP_HOST is set) or Resend.
# EMAIL_FROM must be the SMTP login's own address (same domain), or SPF/DKIM fails and
# recipients silently drop the mail.
SMTP_HOST=""
# 465 = implicit TLS. Any other port (587) must offer STARTTLS, which is enforced.
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""
EMAIL_FROM="Adcrevia <hello@adcrevia.com>"

# --- Worker -----------------------------------------------------------------------------
# Keep concurrency low on a shared VPS: composition is ffmpeg and uses every core it gets.
WORKER_CONCURRENCY="2"
WORKER_LEASE_MS="120000"
WORKER_IDLE_MS="2000"
# Cap ffmpeg threads per render (optional).
FFMPEG_THREADS=""

# --- Host port --------------------------------------------------------------------------
# The app listens on 127.0.0.1:APP_PORT for nginx. Change it if 3000 is already taken by
# another stack on this server, and update proxy_pass in the nginx config to match.
APP_PORT="3000"
