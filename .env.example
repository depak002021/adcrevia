DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Public origin of the app. Used for absolute media URLs in local storage mode
# and as the allow-list for the cross-origin check in src/proxy.ts.
APP_URL="http://localhost:3000"
# Canonical public URL of the landing page, used for canonical links, the
# sitemap, robots.txt and the social share card. Read at BUILD time (it is a
# NEXT_PUBLIC_ variable), so set it before `pnpm build`. Defaults to
# https://adcrevia.com.
NEXT_PUBLIC_SITE_URL="https://adcrevia.com"
# Short commit SHA, surfaced by /api/health so a deployment can be identified.
# Set by the Docker build; safe to leave unset in development.
APP_REVISION=""

# --- Background worker ------------------------------------------------------
# Jobs processed in parallel by one worker process. Keep this low on a shared
# host: video composition is ffmpeg, which will use everything it is given.
WORKER_CONCURRENCY="2"
# How long a worker holds a claimed job before another may reclaim it. Must
# exceed the slowest single step; FLUX image polling alone can run 240s.
WORKER_LEASE_MS="120000"
# Pause between polls when the queue is empty.
WORKER_IDLE_MS="2000"

# Empty throwaway database used only by `prisma migrate diff --from-migrations`.
# Prisma RESETS whatever this points at, so never aim it at real data.
SHADOW_DATABASE_URL=""
ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"
OPENAI_API_KEY="sk-project-replace-me"
OPENAI_TEXT_MODEL="gpt-5-mini"
OPENAI_IMAGE_MODEL="gpt-image-1.5"

# --- Agentic brief ----------------------------------------------------------
# The model that holds the conversation and calls the brief tools. Falls back to
# OPENAI_TEXT_MODEL. It needs tool calling; a model without it cannot act.
OPENAI_AGENT_MODEL=""

# --- Decision layer ---------------------------------------------------------
# Typed, calibrated judgements: is the brief complete, is this the product the
# user meant, are these directions actually different. Two interchangeable
# backends, resolved in this order:
#   1. DECISION_PROVIDER, an explicit operator override
#   2. an enabled TEXT provider row for TypeSafe in the admin console
#   3. TYPESAFE_API_KEY here
#   4. OpenAI, which needs no extra key
# Set to "openai" or "typesafe" to pin one; leave empty for the order above.
# Pinning "typesafe" with no key configured fails loudly rather than quietly
# answering with OpenAI.
DECISION_PROVIDER=""
# TypeSafe Jev. Faster and far cheaper per judgement than a chat model, and the
# reason the layer is pluggable at all. Optional.
TYPESAFE_API_KEY=""
# Defaults to jev-latest. Pin a version here if you have tuned thresholds
# against one, since an alias moves when a new release ships.
TYPESAFE_DECISION_MODEL=""
# Defaults to https://api.typesafe.ai/v1/systemone. Override only to route
# through a gateway that proxies the same contract.
TYPESAFE_DECISION_ENDPOINT=""
# The OpenAI model used when OpenAI is answering decisions. A classifier wants
# the cheapest model that is still calibrated, which is not necessarily the one
# used for creative writing. Falls back to OPENAI_TEXT_MODEL.
OPENAI_DECISION_MODEL=""
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="replace-me"
R2_SECRET_ACCESS_KEY="replace-me"
R2_BUCKET="adcrevia-media"
R2_PUBLIC_BASE_URL="https://media.example.com"
RUNWAYML_API_SECRET="replace-me"
RUNWAY_VIDEO_MODEL="gen4.5"
# Server-only Black Forest Labs credentials. Database provider configuration
# (Admin > API providers) always takes precedence over these fallbacks.
BFL_API_KEY="replace-me"
BFL_IMAGE_MODEL="flux-2-pro"
BFL_VIDEO_MODEL="flux-3-video"
RESEND_API_KEY="re_replace-me"
EMAIL_FROM="Adcrevia <hello@example.com>"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="replace-with-a-unique-16-character-password"
SUPER_ADMIN_NAME="Adcrevia Administrator"
